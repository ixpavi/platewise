# Copy this file to .env and fill in the values from your Firebase project.
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in: the "Web client (auto created by Google Service)" OAuth client ID.
# Firebase console → Authentication → Sign-in method → Google → Web SDK configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only (optional): reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
